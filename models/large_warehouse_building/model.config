<?xml version="1.0"?>
<model>
  <name>large_warehouse_building</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Juan S. Cely G.</name>
    <email>juanscelyg@gmail.com</email>
  </author>
  <description>
    Structure of the large warehouse: floors, 12 m warehouse walls, 6 m reception walls, loading zone fence, door openings (all at least 3 m wide) with hazard jambs, zone signs over every door, facade signs, floor logos, safety signs, extinguisher cabinets, painted lines and parking. The extinguisher cabinet meshes are those of the local model extinguisher_cabinet (Fuel model "Extinguisher cabinet", CC BY 4.0).
  </description>
</model>
