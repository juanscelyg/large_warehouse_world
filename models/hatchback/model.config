<?xml version="1.0"?>
<model>
  <name>hatchback</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>OpenRobotics</name>
  </author>
  <description>
    Hatchback car. Local copy of the Fuel model "Hatchback copy"
    (https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback%20copy), version 3,
    with the body texture next to the mesh so the material finds it. Its wheels texture is
    also used by the bus and the red hatchback through model://hatchback.
    Licensed under Creative Commons Zero v1.0 Universal.
  </description>
</model>
