<?xml version="1.0"?>
<model>
  <name>dumpster</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>OpenRobotics</name>
  </author>
  <description>
    Dumpster. Local copy of the Fuel model "Dumpster"
    (https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dumpster), version 3,
    with a PBR material instead of the Ogre 1 material script so the texture is rendered with ogre2 and made static so it stays where it is placed, with a simplified box collision.
    Licensed under Creative Commons Zero v1.0 Universal.
  </description>
</model>
