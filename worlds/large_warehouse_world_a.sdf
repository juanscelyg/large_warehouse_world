<?xml version="1.0" ?>
<!-- Generated by scripts/generate_world.py. Large warehouse built from the plan of the
     facility: Warehouse A (200 x 200 m), Warehouse B (200 x 300 m), Warehouse C (300 x 400 m),
     Recepcion y oficinas (300 x 50 m) and the truck loading zone. -->
<sdf version="1.9">
  <!-- large_warehouse_world.sdf without the furniture of Warehouse B, Warehouse C and the
       reception (the buildings stay): every lidar renders the whole scene, and with all of
       it two robots run at half real time. For robots that only work in Warehouse A. -->
  <world name="large_warehouse_world">
    <!-- ODE collision detector: with Bullet a Kobuki tips over and flies away as soon
         as it turns. 4 ms steps, like the small robots' playground worlds. -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>ode</collision_detector>
      </dart>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>350 -260 260 0 0.75 1.5708</pose>
      </camera>
    </gui>

    <!-- Fictional location close to Mostoles (Madrid) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>40.3280</latitude_deg>
      <longitude_deg>-3.8870</longitude_deg>
      <elevation>660</elevation>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.85 0.85 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.3 -0.85</direction>
    </light>

    <!-- Structure, storage and furniture (grouped static models in world coordinates) -->
    <include>
      <uri>model://large_warehouse_building</uri>
      <name>large_warehouse_building</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_a_storage</uri>
      <name>warehouse_a_storage</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <!-- Packages on the floor level of the Warehouse A racks -->
    <include>
      <uri>model://warehouse_a_floor_stock</uri>
      <name>warehouse_a_floor_stock</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://loading_zone_props</uri>
      <name>loading_zone_props</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

